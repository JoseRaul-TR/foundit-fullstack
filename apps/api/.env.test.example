# apps/api/.env.test.example

# Test-only environment, loaded by tests/setup.ts (override:true) before any
# app code is imported. Never used in dev/production — do not put real
# secrets here, these are dummy values (TMDB/Google calls are mocked in
# every suite, never actually made).
NODE_ENV=test
PORT=3099
DATABASE_URL=postgresql://foundit:foundit_dev@localhost:5432/foundit_test?schema=public
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_SECRET=test_secret_minimum_32_characters_long_ok
BETTER_AUTH_URL=http://localhost:3099
TMDB_API_KEY=test-tmdb-key-unused-always-mocked
GOOGLE_CLIENT_ID=test-google-client-id-unused
GOOGLE_CLIENT_SECRET=test-google-client-secret-unused
USE_HTTPS=false