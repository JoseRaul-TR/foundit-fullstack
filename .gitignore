# ─── Dependencies ─────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Build outputs ────────────────────────────────────────────────────────
dist/
.output/
.nuxt/
.nitro/
.data/
.cache/
*.tsbuildinfo

# Vite (used by Nuxt)
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ─── Environment ──────────────────────────────────────────────────────────
# Broad by design: no .env* file is versioned unless explicitly re-included
# at the bottom of this file.
.env
.env.*

# ─── Logs & diagnostics ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock

# ─── Testing & coverage ───────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Tooling caches ───────────────────────────────────────────────────────
.npm
.eslintcache
.stylelintcache
.node_repl_history

# ─── Editors & OS ─────────────────────────────────────────────────────────
.vscode/
.vscode-test/
.idea/
.fleet/
*.swp
.DS_Store
Thumbs.db

# ─── Project-specific ─────────────────────────────────────────────────────
CLAUDE.md
cookies.txt

#GitHub Commit Messages
commit-msg.txt

# NOTE: apps/api/.gitignore used to carry `/src/generated/prisma`, which never
# matched anything — the committed generated client actually lives in
# apps/api/generated/prisma. Deliberately not adding a rule for it here: see
# #146, which decides whether that directory is dead code to delete or output
# that should be generated rather than versioned.

# ─── Re-included on purpose ───────────────────────────────────────────────
# Must stay last: the .env* rules above are broad, and the last matching rule
# wins. These carry placeholder values only and are versioned so a fresh clone
# (and CI) can set up its own environment.
!.env.example
!apps/api/.env.test.example