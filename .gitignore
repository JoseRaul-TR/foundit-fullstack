# ─── Dependencies ─────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ─── Build outputs ────────────────────────────────────────────────────────
dist/
.output/
.nuxt/
.nitro/
.data/
.cache/
*.tsbuildinfo

# Prisma's generator wrote here under an earlier config (`prisma-client`, with
# an explicit output). The schema uses `prisma-client-js` now, which writes into
# node_modules on postinstall. Ignored so a stray generate cannot re-commit it.
apps/api/generated/

# Vite (used by Nuxt)
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ─── Environment ──────────────────────────────────────────────────────────
# Broad by design: no .env* file is versioned unless explicitly re-included
# at the bottom of this file.
.env
.env.*

# ─── Logs & diagnostics ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.seed
*.pid.lock

# ─── Testing & coverage ───────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ─── Tooling caches ───────────────────────────────────────────────────────
.npm
.eslintcache
.stylelintcache
.node_repl_history

# ─── Editors & OS ─────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.vscode-test/
.idea/
.fleet/
*.swp
.DS_Store
Thumbs.db

# ─── Project-specific ─────────────────────────────────────────────────────
cookies.txt

# Personal notes and local agent config — the project-level CLAUDE.md is
# versioned on purpose (#211's rule lives there).
CLAUDE.local.md
.claude/

# GitHub commit messages
commit-msg.txt

# ─── Re-included on purpose ───────────────────────────────────────────────
# Must stay last: the .env* rules above are broad, and the last matching rule
# wins. These carry placeholder values only and are versioned so a fresh clone
# (and CI) can set up its own environment.
!.env.example
!apps/api/.env.test.example
